PORT=25565
# Public base URL of this backend (used to build absolute media URLs Facebook
# can fetch). On the Oracle VM: http://129.225.82.58:25565
PUBLIC_BASE_URL=
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Facebook app (for exchanging a short-lived Page token for a long-lived one
# at connect time). Keep the secret in backend env vars only, never in the repo.
FB_APP_ID=
FB_APP_SECRET=
ORACLE_OBJECT_STORAGE_NAMESPACE=
ORACLE_OBJECT_STORAGE_BUCKET=
ORACLE_OBJECT_STORAGE_REGION=
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
ORACLE_DB_CONNECT_STRING=
# Neon Postgres + Object Storage (DR copy). The DR write is best-effort;
# if these are unset the backend runs on Oracle only.
NEON_DATABASE_URL=
NEON_S3_ENDPOINT=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_S3_REGION=
NEON_S3_BUCKET=
